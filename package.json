{
  "name": "kamome-clinic-hp",
  "version": "1.0.0",
  "description": "かもめクリニック公式サイト（Next.js + TypeScript + Tailwind CSS + shadcn/ui）",
  "type": "module",
  "private": true,
  "engines": {
    "node": "^18.17.1 || ^20.3.0 || >= 21.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "start": "next start",
    "build": "next build",
    "lint": "next lint",
    "check": "npm run check:tsc && npm run check:eslint && npm run check:prettier",
    "check:tsc": "tsc --noEmit",
    "check:eslint": "eslint .",
    "check:prettier": "prettier --check .",
    "check:inline-jp": "node scripts/lint-astro-inline-japanese.mjs --check-baseline",
    "check:inline-jp:report": "node scripts/lint-astro-inline-japanese.mjs --warn",
    "check:inline-jp:update": "node scripts/lint-astro-inline-japanese.mjs --update-baseline",
    "fix": "npm run fix:eslint && npm run fix:prettier",
    "fix:eslint": "eslint --fix .",
    "fix:prettier": "prettier -w ."
  },
  "dependencies": {
    "next": "^15.4.6",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.542.0",
    "tailwindcss-animate": "^1.0.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-navigation-menu": "^1.2.14",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-accordion": "^1.2.12"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.33.0",
    "@tailwindcss/typography": "^0.5.16",
    "autoprefixer": "^10.4.20",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.6",
    "@typescript-eslint/eslint-plugin": "^8.39.0",
    "@typescript-eslint/parser": "^8.39.0",
    "eslint": "^9.33.0",
    "eslint-config-next": "^15.4.6",
    "globals": "^16.3.0",
    "prettier": "^3.6.2",
    "sharp": "0.34.3",
    "tailwind-merge": "^2.6.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.39.0"
  }
}
